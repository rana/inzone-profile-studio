{
  "name": "inzone-profile-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/*.test.ts",
    "test:offline": "python3 -m unittest discover -s scripts -p 'test_offline_package.py'",
    "bundle:offline": "npm run build && python3 scripts/package_offline.py",
    "check": "tsc --noEmit",
    "start": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
